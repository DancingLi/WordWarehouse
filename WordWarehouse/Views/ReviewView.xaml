<UserControl x:Class="WordWarehouse.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="16"
                CornerRadius="10"
                Background="#FCFBF8"
                BorderBrush="#E2DBD1"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Width="110"
                        Margin="0,0,10,0"
                        Command="{Binding MarkNewCommand}"
                        Content="Mark New" />
                <Button Width="130"
                        Margin="0,0,10,0"
                        Command="{Binding MarkLearningCommand}"
                        Content="Mark Learning" />
                <Button Width="130"
                        Margin="0,0,10,0"
                        Command="{Binding MarkMasteredCommand}"
                        Content="Mark Mastered" />
                <Button Width="110"
                        Margin="0,0,10,0"
                        Click="EditSelected_Click"
                        Content="Edit" />
                <Button Width="100"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="16"
                CornerRadius="10"
                Background="#FCFBF8"
                BorderBrush="#E2DBD1"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding ReviewItems}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="110" />
                    <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="100" />
                    <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="*" />
                    <DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="220" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
