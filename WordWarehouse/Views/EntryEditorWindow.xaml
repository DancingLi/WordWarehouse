<Window x:Class="WordWarehouse.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Entry"
        Height="560"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF7F3EA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,12,12" VerticalAlignment="Center" Text="Language" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding Language}" />

            <TextBlock Grid.Row="1" Margin="0,0,12,12" VerticalAlignment="Center" Text="Entry Type" />
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding EntryTypes}"
                      SelectedItem="{Binding EntryType}" />

            <TextBlock Grid.Row="2" Margin="0,0,12,12" VerticalAlignment="Top" Text="Content" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     MinHeight="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Margin="0,0,12,12" VerticalAlignment="Top" Text="Meaning" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     MinHeight="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Margin="0,0,12,12" VerticalAlignment="Top" Text="Example" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     MinHeight="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Example, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Margin="0,0,12,12" VerticalAlignment="Top" Text="Tags" />
            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="6" Margin="0,0,12,0" VerticalAlignment="Top" Text="Notes / Status" />
            <Grid Grid.Row="6" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox MinHeight="90"
                         Margin="0,0,0,12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Row="1"
                          Width="140"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding Status}" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,10,0"
                    Click="Save_Click"
                    Content="Save" />
            <Button Width="110"
                    Click="Cancel_Click"
                    Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
