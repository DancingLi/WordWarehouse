<UserControl x:Class="WordWarehouse.Views.QuickAddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="20"
                    CornerRadius="12"
                    Background="#FCFBF8"
                    BorderBrush="#E2DBD1"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2"
                               Margin="0,0,0,18"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Quick Add" />

                    <TextBlock Grid.Row="1" Margin="0,0,12,12" VerticalAlignment="Center" Text="Language" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}" />

                    <TextBlock Grid.Row="2" Margin="0,0,12,12" VerticalAlignment="Center" Text="Entry Type" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding EntryTypes}"
                              SelectedItem="{Binding SelectedEntryType}" />

                    <TextBlock Grid.Row="3" Margin="0,0,12,12" VerticalAlignment="Top" Text="Content" />
                    <TextBox x:Name="ContentTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,0,0,12"
                             MinHeight="70"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Margin="0,0,12,12" VerticalAlignment="Top" Text="Meaning" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Margin="0,0,0,12"
                             MinHeight="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Margin="0,0,12,12" VerticalAlignment="Top" Text="Example" />
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             Margin="0,0,0,12"
                             MinHeight="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Example, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Margin="0,0,12,12" VerticalAlignment="Top" Text="Tags" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Margin="0,0,0,12"
                             Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Margin="0,0,12,0" VerticalAlignment="Top" Text="Notes" />
                    <TextBox Grid.Row="7"
                             Grid.Column="1"
                             MinHeight="90"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    CornerRadius="12"
                    Background="#F3EEE1">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Capture Rules" />
                    <TextBlock Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Text="Required fields are only language, type, and content so you can save quickly during study." />
                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="Use meaning for translation, example for usage, tags for grouping, and notes for anything else." />
                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="New items start with the New status and will appear in review automatically." />

                    <StackPanel Margin="0,24,0,0"
                                Orientation="Horizontal">
                        <Button Width="110"
                                Margin="0,0,10,0"
                                Padding="12,8"
                                Background="#2F5D50"
                                Foreground="White"
                                BorderBrush="#2F5D50"
                                Command="{Binding SaveCommand}"
                                Content="Save" />
                        <Button Width="110"
                                Padding="12,8"
                                Command="{Binding ClearCommand}"
                                Content="Clear" />
                    </StackPanel>

                    <TextBlock Margin="0,18,0,0"
                               FontWeight="SemiBold"
                               Text="Status" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#4D4D4D"
                               TextWrapping="Wrap"
                               Text="{Binding LastSavedMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
